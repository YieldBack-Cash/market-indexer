# Postgres connection string used by both the indexer and the API.
DATABASE_URL="postgresql://ybc:CHANGE_ME@localhost:5432/ybc_indexer"

# Soroban RPC endpoint. Must match the network the factory is deployed on —
# src/stellar.ts signs simulations with Networks.TESTNET.
SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"

# The YBC factory contract that emits market_created events.
FACTORY_CONTRACT_ADDRESS="C..."

# The YBC router. Its events are the authoritative record of what a user did
# through the app (the base-asset amounts a zap moved, routed YT trades, expired
# exits), filed under the market each one names. Optional: without it the
# frontend's history is reconstructed from yield-manager and pool events alone.
ROUTER_CONTRACT_ADDRESS="C..."

# Ledger to begin indexing from on the very first run only (after that the
# cursor lives in IndexerState.lastLedger). Must be inside the RPC provider's
# event retention window or getEvents will fail. Omit to start at the current
# ledger and index nothing historical.
START_LEDGER=

# Origin allowed by CORS. Defaults to http://localhost:3000.
FRONTEND_ORIGIN="https://app.example.com"

# Redis for BullMQ. Defaults to localhost:6379.
# How often the poller asks the RPC for new ledgers (default 5000). Polls that
# find no new ledger cost one cheap health call.
POLL_INTERVAL_MS=

# Port the API listens on. Defaults to 3001.
PORT=3001

# Shared secret for the /admin curation routes, sent as the X-Admin-Key header.
# Leave unset to disable the admin API entirely (every route returns 503).
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=
