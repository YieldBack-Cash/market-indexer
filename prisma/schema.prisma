// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Get a free hosted Postgres database in seconds: `npx create`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model IndexerState {
  id         Int      @id @default(1)
  lastPolled DateTime @default(now())
  lastLedger Int?
}

model Vault {
  address   String   @id
  markets   Market[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexed from chain, best-effort — the indexer owns these, never hand-edited.
  underlyingSymbol String?
  underlyingAsset  String?
  pool             String?

  // Curated: filled in when vetting the vault and the protocol it lends to.
  displayName      String?
  protocolName     String?
  protocolLogoUrl  String?
  protocolWebsite  String?
  protocolDocsUrl  String?
  protocolAuditUrl String?
  description      String?
  riskText         String?
  curatedAt        DateTime?
  curationNote     String?
}

model Market {
  id                String    @id
  vault             String
  name              String
  ym                String
  pt                String
  yt                String
  pool              String
  maturity          BigInt
  creator           String?
  verified          Boolean   @default(false)
  listed            Boolean   @default(false)
  curatedAt         DateTime?
  curationNote      String?
  currentApy        BigInt?
  apyMin            BigInt?
  apyMax            BigInt?
  feeApy            BigInt?
  // Treasury's share of each trade's fee, 1e7-scaled; from pool_init.
  reserveFeeRate    BigInt?
  // 7-day trailing realized LP fee APY, 1e7-scaled, simple (not compounded).
  // Null until the pool has emitted fee-carrying trades.
  lpFeeApy          BigInt?
  lpFeeApyUpdatedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  vaultRef          Vault     @relation(fields: [vault], references: [address])

  @@index([creator])
  @@index([listed, maturity])
}

model MarketEvent {
  id             String   @id
  ledger         Int
  ledgerClosedAt DateTime
  source         String
  type           String
  txHash         String?
  contractId     String
  market         String
  payload        Json
  createdAt      DateTime @default(now())
}

model FactoryEvent {
  id             String   @id
  ledger         Int
  ledgerClosedAt DateTime
  type           String
  txHash         String?
  vault          String?
  payload        Json
  createdAt      DateTime @default(now())
}

model VaultRateSnapshot {
  id        String   @id @default(cuid())
  vault     String
  rate      Float
  timestamp DateTime @default(now())
}
